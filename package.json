{
  "name": "erp-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.15.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx/esm --watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate dev",
    "db:migrate:deploy": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js migrate deploy",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js generate",
    "db:studio": "node --env-file-if-exists=.env.local node_modules/prisma/build/index.js studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/client": "7.8.0",
    "bullmq": "5.76.8",
    "decimal.js": "10.6.0",
    "fastify": "5.8.5",
    "ioredis": "5.10.1",
    "kysely": "0.29.0",
    "pg": "8.20.0",
    "pino": "9.14.0",
    "pino-pretty": "11.3.0",
    "uuid": "10.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "11.14.0",
    "@types/node": "22.19.19",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.0",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "@vitest/coverage-v8": "4.1.6",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "prisma": "7.8.0",
    "prisma-kysely": "3.1.0",
    "supertest": "7.2.2",
    "testcontainers": "11.14.0",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "vitest": "4.1.6"
  },
  "overrides": {
    "@hono/node-server": "2.0.2"
  }
}
