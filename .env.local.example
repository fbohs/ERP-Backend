# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000

# Database
POSTGRES_USER=erp_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=erp_dev
POSTGRES_PORT=5432
DATABASE_URL=postgresql://erp_user:changeme@localhost:5432/erp_dev

# Redis — session cache (ephemeral, no persistence needed)
REDIS_PASSWORD=changeme
REDIS_PORT=6379
REDIS_URL=redis://:changeme@localhost:6379

# Redis — BullMQ queue (AOF persistence enabled in docker-compose)
QUEUE_REDIS_PASSWORD=changeme
QUEUE_REDIS_PORT=6380
QUEUE_REDIS_URL=redis://:changeme@localhost:6380

# Email (Resend)
RESEND_API_KEY=re_your_key_here
